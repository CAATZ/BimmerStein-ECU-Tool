{
  "id": "softbsl_loader",
  "label": "V10 bounds-checked loader",
  "version": "V10",
  "title": "Soft-BSL 0x5A loader",
  "status": "TESTED",
  "tested": true,
  "user_description": "Persistent Soft-BSL recovery loader with a fully anchored boot hook and a bounded 1-2048 byte RAM-agent upload.",
  "description": "Soft-BSL V10 validates the complete four-byte dispatcher call before replacing it and rejects RAM-agent lengths outside 1..0x800 before ACK, copy, CRC, or execution. The loader remains split across descriptor-safe SA1 gaps (file 0x5C32/0x5D92-0x5E05/0x5FC4), preserves optional coding records at 0x5D36-0x5D90, composes with AMD flash + cal_guard, and includes the 'B' bank marker.",
