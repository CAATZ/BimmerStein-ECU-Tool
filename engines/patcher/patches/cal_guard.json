{
  "id": "cal_guard",
  "label": "V2 exact-ID guard",
  "status": "V2",
  "title": "CalGuard V2 - No-brick Firmware Compatibility ID guard (strict SS1v2)",
  "user_description": "Keeps the ECU in recoverable flash-listen mode when the program and calibration Firmware Compatibility IDs do not match, instead of allowing engine operation with incompatible data. This patch writes the boot/parameter region.",
  "description": "Boot->app handoff splice @0x493A -> SA1 cave @0x5E10 (436-B universal gate). Reloads E740; a real flash session (E740==1) enters stock flash-listen recovery. Otherwise it requires the strict SS1v2 calibration marker to match the SS1v2 program signature, or a supported legacy CAL-ID suffix, then compares all four native program/cal Firmware Compatibility ID bytes exactly. Any exact-ID mismatch, cross-version, foreign, blank, or hybrid image is routed to DS2 flash-listen recovery instead of engine operation (no EEPROM wear; self-clearing after a correct re-flash). SA1 (re-apply on SA1 write).",
  "target": "MS41.3",
  "targets": ["MS41.0", "MS41.1", "MS41.2", "MS41.3"],
